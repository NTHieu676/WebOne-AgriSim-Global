PORT=3000

FIREBASE_PROJECT_ID=web1-agrisim-global

FRONTEND_URL=http://localhost:5500, http://127.0.0.1:5500

NODE_ENV=development

# Leave empty when using Application Default Credentials locally.
# On Render, add the one-line JSON service-account value as a protected secret.

# Muốn dùng thì hỏi Makutt để cấp quyền vào firebase để dùng.
FIREBASE_SERVICE_ACCOUNT_JSON=
